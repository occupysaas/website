{
  "name": "occupysaas-website",
  "private": true,
  "version": "1.0.0",
  "description": "Public site for OccupySaaS",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/site.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./assets/css/site.css --watch",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
